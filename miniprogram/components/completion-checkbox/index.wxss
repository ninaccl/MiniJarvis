.row { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; }.box { width: 34rpx; height: 34rpx; flex-shrink: 0; border: 2rpx solid #AEB6C2; border-radius: 50%; color: #FFFFFF; font-size: 23rpx; line-height: 32rpx; text-align: center; }.checked { border-color: #007AFF; background: #007AFF; }.label { color: #111827; font-size: 29rpx; }.complete { color: #6B7280; text-decoration: line-through; }.disabled { opacity: .5; }
