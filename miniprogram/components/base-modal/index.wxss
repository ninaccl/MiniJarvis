.mask { position: fixed; inset: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(15,23,42,.36); }.sheet { width: 100%; box-sizing: border-box; padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #FFFFFF; }.sheet-title { color: #111827; margin-bottom: 20rpx; font-size: 34rpx; font-weight: 700; }.actions { display: flex; gap: 16rpx; margin-top: 28rpx; }.actions button { flex: 1; padding: 20rpx; font-size: 29rpx; }.cancel { color: #6B7280; background: #F3F4F6; }.confirm { color: #FFFFFF; background: #007AFF; }
