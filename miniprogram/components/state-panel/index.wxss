.state-panel { box-sizing: border-box; padding: 48rpx 30rpx; border: 1rpx solid rgba(15,23,42,.08); border-radius: 24rpx; background: #FFFFFF; text-align: center; }
.state-title { color: #111827; font-size: 31rpx; font-weight: 600; }.state-description { color: #6B7280; margin-top: 12rpx; font-size: 27rpx; line-height: 1.5; }.retry { color: #007AFF; background: #EAF4FF; margin-top: 24rpx; padding: 14rpx 28rpx; font-size: 27rpx; }.spinner { width: 32rpx; height: 32rpx; margin: 0 auto 20rpx; border: 4rpx solid #D9EAFE; border-top-color: #007AFF; border-radius: 50%; animation: spin 800ms linear infinite; }@keyframes spin { to { transform: rotate(360deg); } }@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
