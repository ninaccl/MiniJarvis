<view class="page"><top-bar title="家中库存" subtitle="知道家里有什么，少一点浪费" avatar="{{avatar}}" bind:settings="openSettings"/>
  <view class="toolbar"><input class="search" placeholder="搜索食材" maxlength="200" value="{{q}}" data-field="q" bindinput="input" bindconfirm="load"/><button class="secondary-button" bindtap="load">搜索</button></view>
  <scroll-view scroll-x class="pills"><button wx:for="{{filters}}" wx:key="code" class="pill {{status === item.code ? 'selected' : ''}}" data-status="{{item.code}}" bindtap="filter">{{item.name}}</button></scroll-view>
  <view class="toolbar"><button class="primary-button grow" bindtap="add">＋ 添加库存</button><button class="secondary-button" bindtap="showHistory">流水</button></view>
  <state-panel wx:if="{{error && !sheet}}" type="error" title="操作失败" description="{{error}}" bind:retry="load"/>
  <state-panel wx:if="{{loading}}" type="loading" title="正在加载库存"/>
  <view wx:if="{{totals.length}}" class="section-label">当前筛选内可用总量</view><view class="summary-grid"><view wx:for="{{totals}}" wx:key="key" class="summary-cell"><view>{{item.name}}</view><view class="accent">{{item.quantity}} {{item.unit_code}}</view></view></view>
  <state-panel wx:if="{{!loading && !error && !batches.length}}" title="没有库存记录" description="添加一批食材，记录数量与保质期。"/>
  <surface-card wx:for="{{batches}}" wx:key="id"><view class="toolbar"><view class="card-title grow">{{item.ingredient_name}}</view><status-pill tone="{{item.status === 'expired' ? 'danger' : item.status === 'expiring' ? 'warning' : 'neutral'}}" text="{{item.status === 'expired' ? '已过期' : item.status === 'expiring' ? '三天内到期' : item.status === 'inactive' ? '已用完' : '可用'}}"/></view><view class="stock-amount">{{item.base_quantity}} {{item.base_unit_code}}</view><view class="muted">到期：{{item.expiry_date || '未设置'}} · 批次 #{{item.id}}</view><view class="muted">{{item.note}}</view><view class="toolbar block"><button class="secondary-button grow" data-batch="{{item}}" bindtap="adjust">调整数量</button><button class="secondary-button" data-batch="{{item}}" bindtap="edit">编辑</button></view></surface-card>
  <view class="section-label">用现有食材做什么</view><surface-card><view class="toolbar"><input class="field quantity-input" type="number" value="{{count}}" data-field="count" bindinput="input"/><view class="muted grow">道菜（1–10）</view><button class="primary-button" disabled="{{working}}" bindtap="match">推荐</button></view><view class="muted">依次分配可用食材，默认推荐两道菜。</view></surface-card>
  <view wx:if="{{matched && !matches.length}}" class="muted block">先记录菜谱，才能匹配家中库存。</view>
  <surface-card wx:for="{{matches}}" wx:key="recipe_id" wx:for-item="match"><button class="text-button card-title" data-id="{{match.recipe.id}}" bindtap="detail">{{match.recipe.title}}</button><view class="accent">{{match.fully_matched ? '食材齐全' : '还需补充食材'}} · {{match.score.satisfied_count}} / {{match.score.required_count}} 项</view><view wx:for="{{match.matched_ingredients}}" wx:key="ingredient_id" class="muted">✓ {{item.name}}：{{item.quantity === null ? '有库存（适量）' : '数量足够'}}</view><view wx:for="{{match.missing_ingredients}}" wx:key="ingredient_id" class="warning-text">缺 {{item.name}} {{item.missing_base_quantity === null ? '适量' : item.missing_base_quantity}} {{item.base_unit_code || ''}}</view></surface-card>
  <view wx:if="{{sheet}}" class="sheet-mask"><scroll-view scroll-y class="sheet"><view class="toolbar"><view class="card-title grow">{{sheet === 'history' ? '库存流水' : sheet === 'add' ? '添加一批库存' : form.ingredient_name}}</view><button class="text-button" bindtap="closeSheet">关闭</button></view><view wx:if="{{error}}" class="error-message">{{error}}</view>
    <block wx:if="{{sheet === 'history'}}"><view wx:for="{{history}}" wx:key="id" class="list-row"><view><view>{{item.ingredient_name}} · {{item.operation === 'consume' ? '消耗' : item.operation === 'set' ? '设定' : '增加'}}</view><view class="muted">批次 #{{item.batch_id}} · {{item.occurredLabel}}</view><view class="muted">{{item.note}}</view></view><text>{{item.base_delta}} {{item.base_unit_code}}</text></view><view wx:if="{{!history.length && !historyLoading}}" class="muted block">还没有变动记录</view><button wx:if="{{historyMore}}" class="secondary-button block" loading="{{historyLoading}}" bindtap="moreHistory">加载更多</button></block>
    <block wx:else>
      <input wx:if="{{sheet === 'add'}}" class="field" placeholder="食材名称" maxlength="120" value="{{form.ingredient_name}}" data-field="form.ingredient_name" bindinput="input"/>
      <picker wx:if="{{sheet === 'move'}}" range="{{operations}}" range-key="name" value="{{operationIndex}}" bindchange="operation"><view class="field">操作：{{operations[operationIndex].name}} ▾</view></picker>
      <view wx:if="{{sheet !== 'edit'}}" class="toolbar"><input class="field grow" type="digit" placeholder="实际数量（大于 0）" value="{{form.quantity}}" data-field="form.quantity" bindinput="input"/><picker range="{{units}}" range-key="name" bindchange="unit"><view class="field">{{form.unit_code}} ▾</view></picker></view>
      <view wx:if="{{sheet === 'move'}}" class="muted block">清空一批食材时，选择“消耗”并输入全部余量。</view>
      <view wx:if="{{sheet !== 'move'}}" class="toolbar"><picker class="grow" mode="date" value="{{form.expiry_date}}" data-field="form.expiry_date" bindchange="input"><view class="field">到期：{{form.expiry_date || '可选'}}</view></picker><button class="text-button" bindtap="clearExpiry">清除</button></view>
      <input class="field" placeholder="备注（可选）" maxlength="255" value="{{form.note}}" data-field="form.note" bindinput="input"/><button class="primary-button block" loading="{{working}}" disabled="{{working}}" bindtap="save">保存</button>
    </block>
  </scroll-view></view>
</view>
