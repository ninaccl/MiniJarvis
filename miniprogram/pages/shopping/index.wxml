<view class="page"><top-bar title="采购清单" subtitle="按计划补齐，买到后再入库" avatar="{{avatar}}" bind:settings="openSettings"/>
  <surface-card><view class="card-title">选择要采购的餐次</view><view class="muted block">默认今天和明天，可加入任意日期。</view>
    <view wx:for="{{selections}}" wx:key="date" wx:for-item="selection" class="selection-row"><view class="toolbar"><view class="grow">{{selection.date}}</view><button class="text-button" data-date="{{selection.date}}" bindtap="removeDate">移除日期</button></view><view class="toolbar"><completion-checkbox wx:for="{{selection.choices}}" wx:key="code" class="grow" label="{{item.name}}" checked="{{item.checked}}" data-date="{{selection.date}}" data-meal="{{item.code}}" bind:change="toggleMeal"/></view></view>
    <picker mode="date" bindchange="addDate"><view class="date-button">＋ 添加日期</view></picker><button class="primary-button block" disabled="{{working}}" loading="{{working}}" bindtap="generate">生成采购清单</button>
  </surface-card>
  <state-panel wx:if="{{error && !sheet}}" type="error" title="操作失败" description="{{error}}" bind:retry="load"/>
  <block wx:if="{{list}}"><view class="section-label">{{list.name}}</view><surface-card><view class="toolbar"><status-pill tone="{{list.status === 'completed' ? 'success' : 'primary'}}" text="{{list.status === 'completed' ? '清单已完成' : '采购中'}}"/><view class="muted">{{list.checked_count}} / {{list.item_count}} 已勾选</view></view><view wx:if="{{!list.items.length}}" class="muted block">无需补充食材。可能库存已足够，或所选餐次还未安排菜谱。</view>
    <view wx:for="{{list.items}}" wx:key="id" class="shopping-item"><completion-checkbox label="{{item.ingredient_name}}" checked="{{item.checked}}" disabled="{{working}}" data-id="{{item.id}}" bind:change="check"/><view class="toolbar"><view class="grow"><view>{{item.quantity === null ? '适量' : item.quantity}} {{item.unit_code || ''}}</view><view class="muted">已抵扣库存：{{item.inventory_offset === null ? '按有无判断' : item.inventory_offset}}</view></view><status-pill wx:if="{{item.stocked_at}}" tone="success" text="已入库"/><button wx:else class="secondary-button" disabled="{{working}}" data-item="{{item}}" bindtap="stock">实际入库</button></view></view>
    <button class="secondary-button block" disabled="{{working}}" bindtap="complete">{{list.status === 'completed' ? '重新打开清单' : '完成清单'}}</button><view class="muted">完成清单不会自动修改库存。</view>
  </surface-card></block>
  <view class="section-label">历史清单</view><state-panel wx:if="{{loading && !history.length}}" type="loading" title="正在加载清单"/><view wx:if="{{!loading && !history.length}}" class="muted block">还没有生成过清单</view>
  <surface-card wx:for="{{history}}" wx:key="id"><button class="text-button" data-id="{{item.id}}" bindtap="openList"><view class="card-title">{{item.name}}</view><view class="muted">{{item.status === 'completed' ? '已完成' : '采购中'}} · {{item.checked_count}} / {{item.item_count}} 项</view></button></surface-card><button wx:if="{{historyMore}}" class="secondary-button block" loading="{{loading}}" bindtap="moreHistory">加载更多</button>
  <view wx:if="{{sheet}}" class="sheet-mask"><scroll-view scroll-y class="sheet"><view class="toolbar"><view class="card-title grow">实际入库 · {{stockItem.ingredient_name}}</view><button class="text-button" bindtap="closeSheet">关闭</button></view><view wx:if="{{error}}" class="error-message">{{error}}</view><view class="muted block">填写这次实际买到的数量。每项只能入库一次。</view><view class="toolbar"><input class="field grow" type="digit" placeholder="实际购买数量" value="{{form.quantity}}" data-field="form.quantity" bindinput="input"/><picker range="{{units}}" range-key="name" bindchange="unit"><view class="field">{{form.unit_code}} ▾</view></picker></view><view class="toolbar"><picker mode="date" class="grow" value="{{form.expiry_date}}" data-field="form.expiry_date" bindchange="input"><view class="field">到期：{{form.expiry_date || '可选'}}</view></picker><button class="text-button" bindtap="clearExpiry">清除</button></view><input class="field" placeholder="备注（可选）" maxlength="255" value="{{form.note}}" data-field="form.note" bindinput="input"/><button class="primary-button block" loading="{{working}}" disabled="{{working}}" bindtap="saveStock">确认实际数量并入库</button></scroll-view></view>
</view>
