<view class="page"><top-bar title="家庭待办" subtitle="把家里的事一起做好" avatar="{{avatar}}" bind:settings="openSettings"/>
  <view class="toolbar"><button class="pill {{status === 'pending' ? 'selected' : ''}}" data-status="pending" bindtap="filter">待完成</button><button class="pill {{status === 'completed' ? 'selected' : ''}}" data-status="completed" bindtap="filter">已完成</button><button class="pill {{status === 'all' ? 'selected' : ''}}" data-status="all" bindtap="filter">全部</button></view>
  <picker range="{{filterMembers}}" range-key="nickname" value="{{filterIndex}}" bindchange="filterMember"><view class="field">{{filterMembers[filterIndex].nickname}} ▾</view></picker><button class="primary-button block" bindtap="create">＋ 新建待办</button>
  <state-panel wx:if="{{loading}}" type="loading" title="正在加载待办"/><state-panel wx:if="{{error && !sheet}}" type="error" title="操作失败" description="{{error}}" bind:retry="load"/><state-panel wx:if="{{!loading && !error && !cards.length}}" title="这里暂时没有任务" description="换个筛选条件，或创建一项家庭待办。"/>
  <surface-card wx:for="{{cards}}" wx:key="id" wx:for-item="parent">
    <view class="toolbar"><completion-checkbox class="grow" label="{{parent.title}}" checked="{{parent.status === 'completed'}}" disabled="{{working}}" data-id="{{parent.id}}" bind:change="toggle"/><button class="text-button" data-id="{{parent.id}}" bindtap="edit">编辑</button></view>
    <view class="muted">{{parent.assigneeName}} {{parent.dueText}}</view><view wx:if="{{!parent.matchesFilter}}" class="muted">父任务（子任务符合筛选）</view><status-pill wx:if="{{parent.dueLabel}}" tone="warning" text="{{parent.dueLabel}}"/>
    <view wx:for="{{parent.children}}" wx:key="id" class="child-task"><view class="toolbar"><completion-checkbox class="grow" label="{{item.title}}" checked="{{item.status === 'completed'}}" disabled="{{working}}" data-id="{{item.id}}" bind:change="toggle"/><button class="text-button" data-id="{{item.id}}" bindtap="edit">编辑</button></view><view class="muted">{{item.assigneeName}} {{item.dueText}}</view><status-pill wx:if="{{item.dueLabel}}" tone="warning" text="{{item.dueLabel}}"/></view>
    <button wx:if="{{parent.status === 'pending'}}" class="secondary-button block" data-parent="{{parent.id}}" bindtap="create">＋ 添加子任务</button>
  </surface-card>
  <view wx:if="{{sheet}}" class="sheet-mask"><scroll-view scroll-y class="sheet"><view class="toolbar"><view class="card-title grow">{{form.id ? '编辑待办' : form.parent_id ? '新建子任务' : '新建待办'}}</view><button class="text-button" bindtap="closeSheet">关闭</button></view><view wx:if="{{error}}" class="error-message">{{error}}</view><input class="field" placeholder="任务名称" maxlength="200" value="{{form.title}}" data-field="form.title" bindinput="input"/><picker range="{{members}}" range-key="nickname" value="{{memberIndex}}" bindchange="member"><view class="field">负责人：{{members[memberIndex].nickname}} ▾</view></picker><view class="toolbar"><picker class="grow" mode="date" value="{{date}}" data-field="date" bindchange="input"><view class="field">截止：{{date || '可选'}}</view></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="input"><view class="field">{{time}}</view></picker><button class="text-button" bindtap="clearDue">清除</button></view><view class="muted block">时间按北京时间；截止前 24 小时显示临期提示。</view><button class="primary-button block" disabled="{{working}}" loading="{{working}}" bindtap="save">保存待办</button><button wx:if="{{form.id}}" class="danger-button block" disabled="{{working}}" bindtap="remove">删除待办</button></scroll-view></view>
</view>
