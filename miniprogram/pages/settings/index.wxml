<view class="page"><view class="screen-title">家庭与设置</view><view class="muted intro">管理成员、邀请码和提醒偏好。</view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在加载设置" />
  <state-panel wx:elif="{{error}}" type="error" title="加载失败" description="{{error}}" bind:retry="load" />
  <block wx:else>
    <view class="section-label">我的资料</view>
    <surface-card><view class="profile-row"><button class="profile-avatar-choice" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="选择微信头像"><image wx:if="{{profileAvatar}}" class="profile-avatar-image" src="{{profileAvatar}}" mode="aspectFill"/><view wx:else class="profile-avatar-placeholder">＋</view></button><view class="profile-help"><view class="member-name">微信头像</view><view class="muted">选择后自动同步到家庭成员</view></view></view><input class="field profile-nickname" type="nickname" maxlength="30" value="{{profileNickname}}" placeholder="点击选用微信昵称" bindinput="editNickname" bindchange="confirmNickname" bindblur="confirmNickname"/><button class="secondary-button control" loading="{{working}}" disabled="{{working}}" bindtap="saveProfile">保存我的资料</button></surface-card>
    <surface-card><view class="row"><view><view class="card-title">{{household.name}}</view><view class="muted">当前家庭</view></view><status-pill tone="primary" text="{{household.role === 'owner' ? '创建者' : '成员'}}" /></view></surface-card>
    <view class="section-label">我的家庭</view><surface-card padded="{{false}}"><view wx:for="{{households}}" wx:key="id" class="member-row" data-id="{{item.id}}" bindtap="switchHousehold"><view class="member-copy"><view class="member-name">{{item.name}}</view><view class="muted">{{item.role === 'owner' ? '创建者' : '成员'}}{{item.id === household.id ? ' · 当前家庭' : ''}}</view></view><view wx:if="{{item.id !== household.id}}" class="muted">切换 ›</view></view></surface-card><button class="secondary-button control" bindtap="addHousehold">创建或加入其他家庭</button>
    <view class="section-label">家庭成员</view><surface-card padded="{{false}}"><view wx:for="{{members}}" wx:key="user_id" class="member-row"><image wx:if="{{item.avatarUrl}}" class="member-avatar member-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="member-avatar">{{item.avatarInitial}}</view><view class="member-copy"><view class="member-name">{{item.displayName}}</view><view class="muted">{{item.role === 'owner' ? '创建者' : '成员'}}</view></view><button wx:if="{{household.role === 'owner' && item.role !== 'owner'}}" class="remove" data-member="{{item}}" bindtap="removeMember">移除</button></view></surface-card>
    <block wx:if="{{household.role === 'owner'}}"><view class="section-label">邀请码</view><view class="invite-card"><view class="muted">{{inviteCode ? '重置后，旧的邀请码将立即失效。' : '邀请码仅在创建或重置时显示。'}}</view><view wx:if="{{inviteCode}}" class="invite-row"><view class="invite-code">{{inviteCode}}</view><button class="secondary-button copy-invite" bindtap="copyInvite">复制</button></view><button class="secondary-button control" loading="{{working}}" bindtap="resetInvite">重置邀请码</button></view></block>
    <view class="section-label">通知</view><surface-card><view class="preference"><view><view class="member-name">待办到期提醒</view><view class="muted">任务到期前一天提醒</view></view><switch color="#007AFF" checked="{{preferences.task_due}}" data-key="task_due" bindchange="togglePreference" /></view><view class="preference"><view><view class="member-name">食材临期提醒</view><view class="muted">每天汇总未来三天临期食材</view></view><switch color="#007AFF" checked="{{preferences.inventory_expiry}}" data-key="inventory_expiry" bindchange="togglePreference" /></view><button class="secondary-button control" data-type="task_due" bindtap="requestSubscription">授权待办提醒</button><button class="secondary-button control" data-type="inventory_expiry" bindtap="requestSubscription">授权临期提醒</button></surface-card>
    <view class="section-label">家庭管理</view><surface-card><button wx:if="{{household.role !== 'owner'}}" class="secondary-button control" loading="{{working}}" bindtap="leaveHousehold">退出家庭</button><button wx:else class="secondary-button control" style="color:#FF3B30" loading="{{working}}" bindtap="dissolveHousehold">解散家庭</button></surface-card>
  </block>
</view>
