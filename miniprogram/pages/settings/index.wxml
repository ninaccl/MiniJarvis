<view class="page"><view class="screen-title">家庭与设置</view><view class="muted intro">管理成员、邀请码和提醒偏好。</view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在加载设置" />
  <state-panel wx:elif="{{error}}" type="error" title="加载失败" description="{{error}}" bind:retry="load" />
  <block wx:else>
    <surface-card><view class="row"><view><view class="card-title">{{household.name}}</view><view class="muted">当前家庭</view></view><status-pill tone="primary" text="{{household.role === 'owner' ? '创建者' : '成员'}}" /></view></surface-card>
    <view class="section-label">我的家庭</view><surface-card padded="{{false}}"><view wx:for="{{households}}" wx:key="id" class="member-row" data-id="{{item.id}}" bindtap="switchHousehold"><view class="member-copy"><view class="member-name">{{item.name}}</view><view class="muted">{{item.role === 'owner' ? '创建者' : '成员'}}{{item.id === household.id ? ' · 当前家庭' : ''}}</view></view><view wx:if="{{item.id !== household.id}}" class="muted">切换 ›</view></view></surface-card><button class="secondary-button control" bindtap="addHousehold">创建或加入其他家庭</button>
    <view class="section-label">家庭成员</view><surface-card padded="{{false}}"><view wx:for="{{members}}" wx:key="user_id" class="member-row"><view class="member-avatar">{{item.avatar}}</view><view class="member-copy"><view class="member-name">{{item.nickname || '家庭成员'}}</view><view class="muted">{{item.role === 'owner' ? '创建者' : '成员'}}</view></view><button wx:if="{{household.role === 'owner' && item.role !== 'owner'}}" class="remove" data-member="{{item}}" bindtap="removeMember">移除</button></view></surface-card>
    <block wx:if="{{household.role === 'owner'}}"><view class="section-label">邀请码</view><surface-card><view class="muted">重置后，旧的邀请码将立即失效。</view><view wx:if="{{inviteCode}}" class="invite-code">{{inviteCode}}</view><button class="secondary-button control" loading="{{working}}" bindtap="resetInvite">重置邀请码</button></surface-card></block>
    <view class="section-label">通知</view><surface-card><view class="preference"><view><view class="member-name">待办到期提醒</view><view class="muted">任务到期前一天提醒</view></view><switch color="#007AFF" checked="{{preferences.task_due}}" data-key="task_due" bindchange="togglePreference" /></view><view class="preference"><view><view class="member-name">食材临期提醒</view><view class="muted">每天汇总未来 {{preferences.expiry_days}} 天临期食材</view></view><switch color="#007AFF" checked="{{preferences.inventory_expiry}}" data-key="inventory_expiry" bindchange="togglePreference" /></view><view class="preference"><view class="member-name">临期范围</view><view class="toolbar"><input class="field expiry-days-input" type="number" value="{{expiryDaysInput}}" bindinput="expiryDaysInput"/><view class="muted">天</view></view></view><button class="secondary-button control" loading="{{working}}" disabled="{{working}}" bindtap="saveExpiryDays">保存临期天数</button><button class="secondary-button control" data-type="task_due" bindtap="requestSubscription">授权待办提醒</button><button class="secondary-button control" data-type="inventory_expiry" bindtap="requestSubscription">授权临期提醒</button></surface-card>
    <view class="section-label">家庭管理</view><surface-card><button wx:if="{{household.role !== 'owner'}}" class="secondary-button control" loading="{{working}}" bindtap="leaveHousehold">退出家庭</button><button wx:else class="secondary-button control danger" loading="{{working}}" bindtap="dissolveHousehold">解散家庭</button></surface-card>
  </block>
</view>
