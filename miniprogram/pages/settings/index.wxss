.intro { margin-top: 12rpx; }
.section-label { color: #6B7280; margin: 32rpx 6rpx 14rpx; font-size: 24rpx; font-weight: 600; }
.row, .preference, .profile-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.card-title, .member-name { color: #111827; font-size: 30rpx; font-weight: 650; }
.profile-row { justify-content: flex-start; }
.profile-avatar-choice { display: flex; flex: 0 0 88rpx; align-items: center; justify-content: center; width: 88rpx; max-width: 88rpx; height: 88rpx; padding: 0; overflow: hidden; border-radius: 20rpx; background: #EAF4FF; }
.profile-avatar-image { width: 88rpx; height: 88rpx; }
.profile-avatar-placeholder { color: #007AFF; font-size: 40rpx; }
.profile-help { flex: 1; min-width: 0; }
.profile-nickname { margin-top: 24rpx; }
.member-row { display: flex; align-items: center; padding: 24rpx 28rpx; border-bottom: 1rpx solid rgba(15,23,42,.08); }
.member-row:last-child { border-bottom: 0; }
.member-avatar { display: flex; flex: 0 0 58rpx; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 18rpx; border-radius: 50%; color: #007AFF; background: #EAF4FF; font-size: 25rpx; font-weight: 700; }
.member-avatar-image { display: block; object-fit: cover; }
.member-copy { flex: 1; min-width: 0; }
.remove { display: flex; flex: 0 0 112rpx; align-items: center; justify-content: center; width: 112rpx; max-width: 112rpx; padding: 0; color: #FF3B30; background: #FFF0EF; font-size: 24rpx; }
.preference { padding: 20rpx 0; border-bottom: 1rpx solid rgba(15,23,42,.08); }
.preference:last-of-type { border-bottom: 0; }
.control { width: 100%; margin-top: 22rpx; }
.invite-card { position: relative; box-sizing: border-box; padding: 28rpx; border: 1rpx solid rgba(15,23,42,.08); border-radius: 22rpx; background: #FFFFFF; }
.invite-row { display: flex; align-items: center; min-height: 88rpx; margin-top: 20rpx; }
.invite-code { color: #007AFF; font-family: monospace; font-size: 42rpx; font-weight: 700; letter-spacing: 6rpx; }
.copy-invite { position: absolute; top: 92rpx; right: 28rpx; display: flex; align-items: center; justify-content: center; width: 112rpx; max-width: 112rpx; margin: 0; padding: 0; }

.expiry-days-input { width: 120rpx; margin: 0; text-align: center; }
