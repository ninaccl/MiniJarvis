.intro { margin-top: 12rpx; }.section-label { color: #6B7280; margin: 32rpx 6rpx 14rpx; font-size: 24rpx; font-weight: 600; }.row, .preference { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.card-title, .member-name { color: #111827; font-size: 30rpx; font-weight: 650; }.member-row { display: flex; align-items: center; padding: 24rpx 28rpx; border-bottom: 1rpx solid rgba(15,23,42,.08); }.member-row:last-child { border-bottom: 0; }.member-avatar { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; margin-right: 18rpx; border-radius: 50%; color: #007AFF; background: #EAF4FF; font-size: 25rpx; font-weight: 700; }.member-copy { flex: 1; min-width: 0; }.remove { display: flex; flex: 0 0 112rpx; align-items: center; justify-content: center; width: 112rpx; max-width: 112rpx; padding: 0; color: #FF3B30; background: #FFF0EF; font-size: 24rpx; }.preference { padding: 20rpx 0; border-bottom: 1rpx solid rgba(15,23,42,.08); }.preference:last-of-type { border-bottom: 0; }.control { width: 100%; margin-top: 22rpx; }.invite-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }.invite-code { color: #007AFF; font-family: monospace; font-size: 42rpx; font-weight: 700; letter-spacing: 6rpx; }.copy-invite { display: flex; flex: 0 0 112rpx; align-items: center; justify-content: center; width: 112rpx; max-width: 112rpx; padding: 0; }
